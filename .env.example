# Copy this file to .env (or export these directly) to enable optional real integrations.
# Nothing here is required -- the project runs fully without any of it, using
# mocked/rule-based fallbacks.

# Slack Incoming Webhook URL -- enables real Slack notifications when a Tier 2/3
# containment action needs approval. See README "Slack Setup" for how to get one.
SLACK_WEBHOOK_URL=

# Groq API key -- FREE (no credit card), enables LLM-written investigation
# narratives via Groq's fast open-source model inference. Preferred over
# Anthropic if both are set. Get one at https://console.groq.com
GROQ_API_KEY=

# Anthropic API key -- OPTIONAL paid alternative if you'd rather use Claude
# for investigation narratives instead of Groq. Only used if GROQ_API_KEY is
# not set. Get one at https://console.anthropic.com/settings/keys
# Costs real money per call -- see Decision 015/017 in the architecture doc.
ANTHROPIC_API_KEY=
